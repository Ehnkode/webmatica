{
  "schemaVersion": 1,
  "id": "webmatica",
  "version": "${version}",
  "name": "Webmatica",
  "description": "Your world in the browser and in game: map, 3D view, chest search, selection tool, schematic editor and Litematica/Baritone automation. Client side, viewer built in.",
  "authors": ["Ehnkode"],
  "contact": {
    "homepage": "https://github.com/Ehnkode/webmatica",
    "sources": "https://github.com/Ehnkode/webmatica",
    "issues": "https://github.com/Ehnkode/webmatica/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/webmatica/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.ehnkode.webmatica.WebmaticaClient"]
  },
  "mixins": [
    "webmatica.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  }
}
